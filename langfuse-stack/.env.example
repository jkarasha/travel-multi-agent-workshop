# Copy to `.env` (same directory as docker-compose.yml) and replace ALL secrets
# before any non-local use. The compose file ships with dev-only defaults so the
# stack can boot with zero config — those defaults are NOT safe for shared or
# production environments.
#
# Generate fresh values with:
#   openssl rand -hex 32      # NEXTAUTH_SECRET, ENCRYPTION_KEY
#   openssl rand -hex 16      # SALT
#
# If port 3000 collides with another local service, override LANGFUSE_PORT.

# --- Langfuse app secrets ---
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=

# --- Datastore credentials ---
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=

# --- Optional: web UI port override (default 3000) ---
# LANGFUSE_PORT=3000
